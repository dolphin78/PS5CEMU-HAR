/* PS5CEMU-HAR's launcher (tools/render-layout.py writes it out twice, each token replaced by each
   side's colours: styles/har.rcss for the Wii U's blue, har-3ds.rcss for the 3DS's gold).

   Box art first, few words: a bar of tabs along the top, the screens under it, and at most four
   controller hints in the bottom right. Everything is laid out on a 1920x1080 page over the moving
   background (bubbles.cpp, wave.cpp), which shows through a dark ground. The fonts are Lexend's
   atlases (tools/render-fonts.py): sizes 20 to 48 in both weights, 56 to 72 in bold; the regular
   weight is 500. The glyphs are white (tools/render-glyphs.py) and tinted with image-color. RmlUi's
   colours take an alpha of 0 to 255. */

body { width: 1920px; height: 1080px; margin: 0px; font-family: Lexend; font-weight: 500; font-size: 28px; color: $text; background-color: $ground; }
#app { position: absolute; left: 0px; top: 0px; width: 1920px; height: 1080px; }
span, div, img { display: block; }
.hidden, .screen, .page, .overlay { display: none; }
.screen.open, .page.open, .overlay.open { display: block; }
.glyph, .pill-glyph, .rail-glyph, .row-glyph { image-color: $text; }

/* -- the bar along the top ------------------------------------------------------------------- */
#topbar { position: absolute; left: 120px; top: 36px; width: 1680px; height: 64px; }
#app.page-open #topbar { display: none; }
#side-mark { position: absolute; left: 0px; top: 6px; width: 52px; height: 52px; border-radius: 14px; background-color: $accent; }
.mark-glyph { position: absolute; left: 8px; top: 8px; width: 36px; height: 36px; image-color: $on-accent; }
#side-name { position: absolute; left: 70px; top: 0px; width: 400px; height: 64px; line-height: 64px; font-size: 28px; font-weight: bold; white-space: nowrap; }
#tabs { position: absolute; left: 440px; top: 4px; width: 800px; height: 56px; text-align: center; }
.tab { display: inline-block; height: 56px; line-height: 56px; padding: 0px 30px; margin: 0px 4px; border-radius: 28px; color: $tab-text; font-size: 28px; }
.tab.selected { background-color: $text; color: $on-accent; font-weight: bold; }
.tab.focused { border: 3px $accent; }
#menu-clock { position: absolute; left: 1480px; top: 0px; width: 200px; height: 64px; line-height: 64px; text-align: right; font-size: 28px; color: $muted; }

/* -- the hints, bottom right ------------------------------------------------------------------ */
#hints { position: absolute; left: 600px; top: 1000px; width: 1200px; height: 40px; text-align: right; white-space: nowrap; z-index: 20; }
.hint { display: inline-block; height: 40px; margin-left: 36px; }
.hint.unused { display: none; }
.hint .glyph { display: inline-block; width: 30px; height: 30px; margin-top: 5px; image-color: $muted; }
.hint-text { display: inline-block; height: 40px; line-height: 40px; margin-left: 10px; font-size: 24px; color: $muted; }

/* -- shared pieces ---------------------------------------------------------------------------- */
.pill { display: inline-block; box-sizing: border-box; height: 76px; line-height: 72px; padding: 0px 42px; margin-right: 18px; border-radius: 38px;
	background-color: $card; border: 2px $card-edge; font-size: 28px; white-space: nowrap; }
.pill span { display: inline-block; }
.pill.primary { background-color: $accent; border: 2px $accent; color: $on-accent; font-weight: bold; }
.pill.primary .pill-glyph { image-color: $on-accent; }
.pill.focused { border: 4px $text; }
.pill.disabled { opacity: 0.45; }
.pill.unused { display: none; }
.pill-glyph { display: inline-block; width: 24px; height: 24px; margin-right: 14px; margin-top: 24px; }
.chip { display: inline-block; height: 36px; line-height: 36px; padding: 0px 16px; margin-right: 10px; border-radius: 18px;
	background-color: rgba(255, 255, 255, 24); color: $text; font-size: 20px; font-weight: bold; white-space: nowrap; }
.chip.unused { display: none; }
.chip.good { background-color: rgba(61, 214, 163, 44); color: #7be8c3; }
.chip.warn { background-color: rgba(255, 170, 60, 44); color: #ffcf8a; }
.chip.bad { background-color: rgba(255, 110, 110, 44); color: #ffa3a3; }
.kicker { font-size: 20px; color: $accent; letter-spacing: 2px; height: 30px; line-height: 30px; white-space: nowrap; }

/* a cover: box art (or an icon) on a card; the ring shows the focus around it */
.tile { position: relative; display: inline-block; border-radius: 14px; background-color: $placeholder; }
.tile-img { position: absolute; left: 0px; top: 0px; }
.tile-text { position: absolute; left: 8px; top: 64%; width: 92%; height: 52px; overflow: hidden; font-size: 20px; line-height: 26px; text-align: center;
	white-space: normal; color: $text; display: none; }
.tile.noart .tile-text { display: block; }
.ring { position: absolute; left: -8px; top: -8px; right: -8px; bottom: -8px; border: 4px $accent; border-radius: 20px; display: none; }
.tile.focused .ring { display: block; }
.tile.unused { display: none; }

/* -- Home ------------------------------------------------------------------------------------- */
#hero-glow { position: absolute; left: 1060px; top: -140px; width: 960px; height: 960px; border-radius: 480px; background-color: $hero-glow; }
/* the kicker, title and facts stand on the buttons: a title of one line or two, they stay together */
#hero-text { position: absolute; left: 120px; bottom: 630px; width: 1120px; }
#hero-kicker { height: 34px; line-height: 34px; font-size: 24px; color: $accent; letter-spacing: 3px; white-space: nowrap; }
#hero-title { max-height: 148px; line-height: 74px; font-size: 64px; font-weight: bold; overflow: hidden; }
#hero-meta { height: 40px; margin-top: 10px; white-space: nowrap; }
#hero-facts { display: inline-block; height: 40px; line-height: 40px; font-size: 28px; color: $muted; margin-right: 18px; }
#hero-status { margin-top: 2px; }
#hero-buttons { position: absolute; left: 120px; top: 470px; width: 1180px; height: 80px; white-space: nowrap; }
#hero-cover { position: absolute; left: 1384px; top: 150px; }
/* the card a game without box art shows its icon on */
.cover-card { position: absolute; border-radius: 28px; background-color: $placeholder; border: 2px $card-edge; display: none; }
.cover-card.visible { display: block; }
#home-notice { position: absolute; left: 120px; top: 640px; width: 1100px; font-size: 28px; line-height: 40px; color: $muted; display: none; }
#home-notice.visible { display: block; }
#shelf-label { position: absolute; left: 120px; top: 618px; font-size: 24px; color: $muted; }
#shelf { position: absolute; left: 120px; top: 664px; width: 1700px; height: 240px; white-space: nowrap; }
.shelf-tile { width: $shelf-w; height: $shelf-h; margin-right: 24px; }
.shelf-tile.all { background-color: $card; border: 2px $card-edge; box-sizing: border-box; }
.all-text { position: absolute; left: 0px; top: 50%; margin-top: -18px; width: 100%; height: 36px; line-height: 36px; text-align: center; font-size: 24px; color: $text; }
#shelf-name { position: absolute; left: 120px; top: 846px; width: 600px; height: 40px; line-height: 40px; font-size: 32px; font-weight: bold; white-space: nowrap; overflow: hidden; }
#shelf-meta { position: absolute; left: 120px; top: 890px; width: 600px; font-size: 24px; color: $muted; white-space: nowrap; overflow: hidden; }
#home.notice #shelf-label, #home.notice #shelf, #home.notice #shelf-name, #home.notice #shelf-meta { display: none; }

/* -- Library ---------------------------------------------------------------------------------- */
#library-head { position: absolute; left: 120px; top: 132px; width: 1680px; height: 64px; white-space: nowrap; }
#library-title { display: inline-block; font-size: 48px; font-weight: bold; height: 64px; line-height: 64px; }
#library-count { display: inline-block; font-size: 28px; color: $muted; height: 64px; line-height: 70px; margin-left: 20px; }
#grid { position: absolute; left: 120px; top: 228px; width: 1720px; height: 720px; }
.cell { width: $cell-w; height: $cell-h; margin-right: 32px; margin-bottom: 32px; }
#grid-scroll { position: absolute; left: 1812px; top: 228px; width: 6px; height: 680px; border-radius: 3px; background-color: $card; }
#grid-scroll.unused { display: none; }
#grid-thumb { position: absolute; left: 0px; top: 0px; width: 6px; height: 100px; border-radius: 3px; background-color: $accent; }
#library-empty { position: absolute; left: 120px; top: 400px; width: 1680px; text-align: center; font-size: 32px; color: $muted; display: none; }
#library-empty.visible { display: block; }
#lib-strip { position: absolute; left: 120px; top: 944px; width: 1300px; height: 48px; white-space: nowrap; }
#lib-name { display: inline-block; height: 48px; line-height: 48px; font-size: 32px; font-weight: bold; }
#lib-meta { display: inline-block; height: 48px; line-height: 48px; font-size: 24px; color: $muted; margin-left: 20px; margin-right: 16px; }
#lib-status { margin-top: 6px; }

/* -- Details: a game's page ------------------------------------------------------------------- */
#details-glow { position: absolute; left: -240px; top: -160px; width: 1100px; height: 1100px; border-radius: 550px; background-color: $hero-glow; }
#details-cover { position: absolute; left: 120px; top: 136px; }
#details-cover-text { position: absolute; left: 120px; top: 880px; width: 560px; text-align: center; font-size: 24px; color: $muted; }
/* the kicker, title, chips and facts stand on the description, however many lines they take */
#details-info { position: absolute; left: 760px; bottom: 530px; width: 1060px; }
#details-kicker { height: 34px; line-height: 34px; font-size: 24px; color: $accent; letter-spacing: 3px; white-space: nowrap; }
#details-title { max-height: 128px; line-height: 64px; font-size: 56px; font-weight: bold; overflow: hidden; margin-top: 2px; }
#details-chips { height: 40px; margin-top: 16px; white-space: nowrap; }
#facts { margin-top: 22px; width: 1060px; }
.fact { display: inline-block; width: 340px; height: 84px; margin-right: 6px; }
.fact.unused { display: none; }
.fact-label { font-size: 20px; color: $dim; height: 30px; line-height: 30px; }
.fact-value { font-size: 28px; height: 40px; line-height: 40px; white-space: nowrap; overflow: hidden; width: 330px; }
#synopsis-box { position: absolute; left: 760px; top: 560px; width: 1040px; height: 252px; overflow: hidden; }
#synopsis { width: 1040px; font-size: 24px; line-height: 36px; color: $muted; }
#details-actions { position: absolute; left: 760px; top: 846px; width: 1100px; height: 80px; white-space: nowrap; }

/* -- Settings: categories down the left, their settings on the right ---------------------------- */
#rail { position: absolute; left: 120px; top: 140px; width: 420px; height: 820px; }
.rail-item { position: relative; height: 66px; margin-bottom: 6px; border-radius: 18px; box-sizing: border-box; padding-left: 24px; white-space: nowrap; }
.rail-glyph { display: inline-block; width: 36px; height: 36px; margin-top: 15px; image-color: $muted; }
.rail-label { display: inline-block; height: 66px; line-height: 66px; margin-left: 18px; font-size: 28px; color: $muted; }
.rail-item.selected { background-color: $focus-fill; }
.rail-item.selected .rail-label { color: $text; font-weight: bold; }
.rail-item.selected .rail-glyph { image-color: $accent; }
.rail-item.focused { border: 3px $accent; }
#panel-title { position: absolute; left: 620px; top: 140px; width: 1180px; height: 60px; line-height: 60px; font-size: 40px; font-weight: bold; }
#srows { position: absolute; left: 620px; top: 214px; width: 1180px; height: 760px; }
.srow { position: relative; box-sizing: border-box; height: 84px; margin-bottom: 12px; border-radius: 20px; background-color: $card; }
.srow.unused { display: none; }
.srow.focused { height: 126px; border: 3px $accent; background-color: $focus-fill; }
.srow-label { position: absolute; left: 30px; top: 0px; width: 560px; height: 80px; line-height: 80px; font-size: 28px; white-space: nowrap; overflow: hidden; }
.srow-value { position: absolute; left: 560px; top: 0px; width: 560px; height: 80px; line-height: 80px; font-size: 28px; color: $muted; text-align: right; white-space: nowrap; overflow: hidden; }
.srow.focused .srow-value { color: $text; }
.srow-desc { position: absolute; left: 30px; top: 70px; width: 1100px; height: 36px; line-height: 36px; font-size: 24px; color: $muted; white-space: nowrap; overflow: hidden; display: none; }
.srow.focused .srow-desc { display: block; }
.srow.dimmed { opacity: 0.5; }
#panel-text { position: absolute; left: 620px; top: 214px; width: 1180px; font-size: 24px; line-height: 38px; color: $muted; }

/* -- pages over the screens: a title, a list, and a panel beside it ------------------------------ */
.page { position: absolute; left: 0px; top: 0px; width: 1920px; height: 1080px; background-color: $shade; }
.page-title { position: absolute; left: 120px; top: 56px; width: 1300px; height: 64px; line-height: 64px; font-size: 48px; font-weight: bold; white-space: nowrap; overflow: hidden; }
.page-copy { position: absolute; left: 122px; top: 124px; width: 1600px; height: 36px; line-height: 36px; font-size: 24px; color: $muted; white-space: nowrap; overflow: hidden; }
.list-panel { position: absolute; left: 120px; top: 186px; width: 820px; height: 790px; }
.list { position: relative; }
.row { position: relative; box-sizing: border-box; height: 80px; margin-bottom: 10px; border-radius: 18px; background-color: $card; }
.row.focused { border: 3px $accent; background-color: $focus-fill; }
.row.chosen { border: 3px $accent; }
.row.offscreen { display: none; }
.row.dimmed { opacity: 0.45; }
.row.heading { background-color: transparent; height: 56px; }
.row.heading .row-label { color: $accent; font-size: 20px; letter-spacing: 2px; top: 16px; }
.row-glyph { position: absolute; left: 24px; top: 28px; width: 24px; height: 24px; image-color: $muted; display: none; }
.row.folder .row-glyph { display: block; }
.row-label { position: absolute; left: 28px; top: 0px; width: 520px; height: 76px; line-height: 76px; font-size: 28px; white-space: nowrap; overflow: hidden; }
.row.folder .row-label { left: 66px; }
.row-value { position: absolute; left: 470px; top: 0px; width: 316px; height: 76px; line-height: 76px; font-size: 24px; color: $muted; text-align: right; white-space: nowrap; overflow: hidden; }
.row.focused .row-value { color: $text; }
.row-value.on { color: $accent; }
.row-value.unset { color: $dim; }
.position { position: absolute; left: 520px; top: 760px; width: 290px; text-align: right; font-size: 20px; color: $muted; }
.empty { display: none; font-size: 28px; color: $muted; padding: 40px 28px; }
.empty.visible { display: block; }
.aside { position: absolute; left: 1000px; top: 186px; width: 800px; height: 790px; box-sizing: border-box; padding: 36px 40px; border-radius: 28px; background-color: $panel; overflow: hidden; }
.aside .kicker { margin-top: 18px; }
.aside-title { font-size: 36px; font-weight: bold; line-height: 46px; margin-bottom: 14px; }
.aside-big { font-size: 40px; font-weight: bold; color: $accent; line-height: 56px; margin-bottom: 18px; }
.aside-text { font-size: 24px; line-height: 36px; color: $muted; }
.pack-text { height: 180px; overflow: hidden; }
.presets-kicker { margin-top: 24px; }
.presets-empty { padding: 10px 0px; font-size: 24px; }
#presets { margin-top: 10px; }
#presets .row-label { width: 300px; font-size: 24px; color: $muted; }
#presets .row-value { left: 250px; width: 440px; font-size: 24px; color: $text; }
.aside .position { left: 400px; top: 730px; width: 360px; }
.facts-small { margin: 20px 0px; }
.facts-small .fact-label { margin-top: 10px; }
.facts-small .fact-value { width: 720px; font-size: 24px; }
.facts-small .fact-value.ready { color: $accent; }

/* -- overlays: a dropdown's choices, a setting's help, a game starting -------------------------- */
.overlay { position: absolute; left: 0px; top: 0px; width: 1920px; height: 1080px; background-color: $shade; z-index: 10; }
.sheet { position: absolute; left: 560px; top: 150px; width: 800px; height: 780px; box-sizing: border-box; padding: 40px; border-radius: 30px;
	background-color: $panel; border: 2px $card-edge; }
.sheet-title { font-size: 36px; font-weight: bold; line-height: 46px; margin: 6px 0px 24px 0px; white-space: nowrap; overflow: hidden; }
.sheet .position { left: 420px; top: 720px; width: 340px; }
#picker .row-label { width: 440px; }
#picker .row-value { left: 440px; width: 250px; }
.info-sheet { left: 460px; width: 1000px; }
.update-sheet { left: 460px; top: 270px; width: 1000px; height: 540px; }
#update-text { height: 170px; }
#update-bar { height: 12px; margin: 26px 0px 30px 0px; border-radius: 6px; background-color: $card; display: none; }
#update-bar.visible { display: block; }
#update-fill { width: 0px; height: 12px; border-radius: 6px; background-color: $accent; }
#update-buttons { position: absolute; left: 40px; bottom: 40px; height: 80px; white-space: nowrap; }
.sheet-text { font-size: 28px; line-height: 42px; color: $muted; }
.overlay.loading { background-color: $shade; }
#loading-cover { position: absolute; left: 800px; top: 250px; }
#loading-title { position: absolute; left: 160px; top: 640px; width: 1600px; height: 72px; line-height: 72px; text-align: center; font-size: 56px; font-weight: bold; white-space: nowrap; overflow: hidden; }
#loading-caption { position: absolute; left: 160px; top: 724px; width: 1600px; text-align: center; font-size: 28px; color: $muted; }

/* -- the start screen (start.rml): each emulator in its own colours ------------------------------ */
#start-left-ground { position: absolute; left: 0px; top: 0px; width: 960px; height: 1080px; background-color: rgba(4, 10, 22, 90); }
#start-right-ground { position: absolute; left: 960px; top: 0px; width: 960px; height: 1080px; background-color: rgba(16, 10, 2, 90); }
#start-wordmark { position: absolute; left: 0px; top: 76px; width: 1920px; height: 56px; line-height: 56px; text-align: center; font-size: 40px; font-weight: bold; letter-spacing: 8px; color: #f3f7ff; }
.start-card { position: absolute; top: 190px; width: 660px; height: 720px; box-sizing: border-box; border-radius: 36px; background-color: rgba(255, 255, 255, 20); border: 2px rgba(255, 255, 255, 30); }
#start-wiiu { left: 150px; } #start-3ds { left: 1110px; }
.start-card.focused.start-wiiu { border: 5px #5aa9ff; background-color: rgba(90, 169, 255, 34); }
.start-card.focused.start-3ds { border: 5px #f4b63f; background-color: rgba(244, 182, 63, 34); }
.start-card.dim { opacity: 0.72; }
.start-art { position: absolute; left: 115px; top: 46px; }
.start-name { position: absolute; left: 0px; top: 484px; width: 650px; height: 84px; line-height: 84px; text-align: center; font-size: 64px; font-weight: bold; }
.start-wiiu .start-name { color: #f3f7ff; } .start-3ds .start-name { color: #fff7e8; }
.start-status { position: absolute; left: 0px; top: 580px; width: 650px; text-align: center; font-size: 28px; }
.start-wiiu .start-status { color: #a9bcd6; } .start-3ds .start-status { color: #d8c6a3; }
#start-version { position: absolute; left: 120px; top: 1004px; width: 400px; font-size: 20px; color: #7f93ae; }

#stream-qr { position: absolute; left: 1190px; top: 500px; width: 198px; height: 198px; visibility: hidden; }
#stream-qr.visible { visibility: visible; }
