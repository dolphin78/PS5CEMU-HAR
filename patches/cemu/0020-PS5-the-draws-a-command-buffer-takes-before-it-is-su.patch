From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5cemu <ps5cemu@localhost>
Date: Tue, 6 Oct 2026 15:51:45 +0000
Subject: [PATCH] PS5: the draws a command buffer takes before it is submitted,
 from the port

Cemu submits its command buffer every 300 draws, and sooner around occlusion queries and readbacks. On the PS5 each submission costs the driver a copy of its words and an AGC submission on Cemu's GPU thread, and the GPU a reset of its state, the preamble and a write-back of its L2, so the count is worth measuring there: it now comes from the port (PS5Cemu_SubmitDraws, ps5cemu.json's cemuSubmitDraws), 300 unless set.
---
 src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
index 4e7be57..009f128 100644
--- a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
+++ b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
@@ -6,6 +6,10 @@ void PS5_NoteCopy(const std::string& key, const std::string& line, bool overrun)
 // The port's in-game menu (port/app/ingame.cpp): its pictures, made where the font's is, before
 // ImGui's render pass begins (a copy may not run inside one)
 void PS5Cemu_ImguiUploads();
+// The draws a command buffer takes before it is submitted (port/app/emulator.cpp: ps5cemu.json's
+// cemuSubmitDraws, 300 as Cemu's own unless set). On the PS5 each submission costs the driver a copy
+// of its words and an AGC submission, and the GPU a reset of its state and a write-back of its caches
+uint32 PS5Cemu_SubmitDraws();
 #endif
 #include "Cafe/HW/Latte/Renderer/Vulkan/VulkanAPI.h"
 #include "Cafe/HW/Latte/Renderer/Vulkan/LatteTextureVk.h"
@@ -2305,7 +2309,11 @@ void VulkanRenderer::SubmitCommandBuffer(VkSemaphore signalSemaphore, VkSemaphor
 	occlusionQuery_notifyBeginCommandBuffer();
 
 	m_recordedDrawcalls = 0;
+#if defined(CEMU_PS5)
+	m_submitThreshold = PS5Cemu_SubmitDraws();
+#else
 	m_submitThreshold = 300;
+#endif
 	m_submitOnIdle = false;
 }
 
