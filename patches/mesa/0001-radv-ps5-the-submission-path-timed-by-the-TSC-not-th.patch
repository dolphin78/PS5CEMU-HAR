From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5cemu <ps5cemu@localhost>
Date: Mon, 5 Oct 2026 21:25:10 +0000
Subject: [PATCH] radv/ps5: the submission path timed by the TSC, not the
 kernel's clock

Every submission read the monotonic clock seven times for the 10 s
statistics line (four in radv_ps5_cs_submit and radv_ps5_note_submission,
three in radv_ps5_submit), and clock_gettime is a system call on the
console: 20 us in PS5_Vulkan R34, about 800 ns in R68. Cemu submits every
300 draws and on every occlusion query, so Breath of the Wild pays this
10 to 30 times a frame on its GPU thread.

The path now reads the TSC (radv_ps5_ticks, about 12 ns), and the
statistics window reads the clock once every 64 submissions, to end the
window and to turn its ticks into milliseconds with the rate measured over
the window itself (no TSC frequency is assumed). The line's fields and
units are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VwQbTVomEg8vnnGcSRXLMp
---
 src/amd/vulkan/winsys/ps5/radv_ps5_cs.c       | 45 ++++++++++++-------
 src/amd/vulkan/winsys/ps5/radv_ps5_platform.c | 32 ++++++++-----
 src/amd/vulkan/winsys/ps5/radv_ps5_platform.h | 13 ++++--
 3 files changed, 61 insertions(+), 29 deletions(-)

diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_cs.c b/src/amd/vulkan/winsys/ps5/radv_ps5_cs.c
index 3251c09..59b4da1 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_cs.c
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_cs.c
@@ -502,32 +502,47 @@ radv_ps5_copy_streams(uint32_t *at, struct ac_cmdbuf **streams, unsigned count)
 }
 
 /* Where the submissions' time goes: a line on stderr every 10 s of a queue
- * that submits (held with the submit lock). */
+ * that submits (held with the submit lock). The times are ticks
+ * (radv_ps5_ticks); the monotonic clock, a system call on the console, is read
+ * once every RADV_PS5_WINDOW_CHECK submissions to end the window and to turn
+ * its ticks into milliseconds. */
+#define RADV_PS5_WINDOW_NS (UINT64_C(10) * 1000 * 1000 * 1000)
+#define RADV_PS5_WINDOW_CHECK 64
+
 static struct {
-   uint64_t window_start, count, words, claim_ns, copy_ns;
+   uint64_t start_ns, start_ticks, count, words, claim_ticks, copy_ticks;
 } radv_ps5_submit_window;
 
 static void
-radv_ps5_note_submission(uint32_t words, uint64_t claim_ns, uint64_t copy_ns)
+radv_ps5_note_submission(uint32_t words, uint64_t claim_ticks, uint64_t copy_ticks)
 {
-   const uint64_t now = os_time_get_nano();
-   if (!radv_ps5_submit_window.window_start)
-      radv_ps5_submit_window.window_start = now;
+   if (!radv_ps5_submit_window.start_ns) {
+      radv_ps5_submit_window.start_ns = os_time_get_nano();
+      radv_ps5_submit_window.start_ticks = radv_ps5_ticks();
+   }
    radv_ps5_submit_window.count++;
    radv_ps5_submit_window.words += words;
-   radv_ps5_submit_window.claim_ns += claim_ns;
-   radv_ps5_submit_window.copy_ns += copy_ns;
-   if (now - radv_ps5_submit_window.window_start < 10ull * 1000 * 1000 * 1000)
+   radv_ps5_submit_window.claim_ticks += claim_ticks;
+   radv_ps5_submit_window.copy_ticks += copy_ticks;
+   if (radv_ps5_submit_window.count % RADV_PS5_WINDOW_CHECK)
+      return;
+   const uint64_t now = os_time_get_nano();
+   if (now - radv_ps5_submit_window.start_ns < RADV_PS5_WINDOW_NS)
       return;
+   const uint64_t now_ticks = radv_ps5_ticks();
+   const uint64_t ticks = now_ticks - radv_ps5_submit_window.start_ticks;
+   const double ms_per_tick = ticks ? (double)(now - radv_ps5_submit_window.start_ns) / 1e6 / (double)ticks : 0.0;
    uint64_t times[3];
    radv_ps5_submit_times(times);
    fprintf(stderr,
            "radv/ps5 submissions: window count=%" PRIu64 " kwords=%" PRIu64 " claim_ms=%.1f copy_ms=%.1f flush_ms=%.1f"
            " agc_ms=%.1f suspend_ms=%.1f\n",
-           radv_ps5_submit_window.count, radv_ps5_submit_window.words / 1024, radv_ps5_submit_window.claim_ns / 1e6,
-           radv_ps5_submit_window.copy_ns / 1e6, times[0] / 1e6, times[1] / 1e6, times[2] / 1e6);
+           radv_ps5_submit_window.count, radv_ps5_submit_window.words / 1024,
+           radv_ps5_submit_window.claim_ticks * ms_per_tick, radv_ps5_submit_window.copy_ticks * ms_per_tick,
+           times[0] * ms_per_tick, times[1] * ms_per_tick, times[2] * ms_per_tick);
    memset(&radv_ps5_submit_window, 0, sizeof(radv_ps5_submit_window));
-   radv_ps5_submit_window.window_start = now;
+   radv_ps5_submit_window.start_ns = now;
+   radv_ps5_submit_window.start_ticks = now_ticks;
 }
 
 static VkResult
@@ -624,9 +639,9 @@ radv_ps5_cs_submit(struct radeon_winsys_ctx *rctx, const struct radv_winsys_subm
    }
 
    const uint64_t seq = queue->submitted_seq + 1;
-   const uint64_t claim_start = os_time_get_nano();
+   const uint64_t claim_start = radv_ps5_ticks();
    uint32_t *const words = too_large ? NULL : radv_ps5_queue_claim(queue, count, seq);
-   const uint64_t copy_start = os_time_get_nano();
+   const uint64_t copy_start = radv_ps5_ticks();
    if (!words) {
       simple_mtx_unlock(&queue->submit_lock);
       util_dynarray_fini(&pieces);
@@ -660,7 +675,7 @@ radv_ps5_cs_submit(struct radeon_winsys_ctx *rctx, const struct radv_winsys_subm
    util_dynarray_fini(&pieces);
    util_dynarray_fini(&units);
 
-   const uint64_t copy_end = os_time_get_nano();
+   const uint64_t copy_end = radv_ps5_ticks();
    p_atomic_set(&queue->submitted_seq, seq);
    int submitted = 0;
    const unsigned parts = util_dynarray_num_elements(&starts, uint32_t);
diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c
index 98783e3..ebab94c 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c
@@ -162,6 +162,16 @@ radv_ps5_now_ns(void)
    return (uint64_t)now.tv_sec * UINT64_C(1000000000) + (uint64_t)now.tv_nsec;
 }
 
+uint64_t
+radv_ps5_ticks(void)
+{
+#if defined(__PROSPERO__)
+   return __builtin_ia32_rdtsc();
+#else
+   return os_time_get_nano();
+#endif
+}
+
 void
 radv_ps5_sleep_us(unsigned microseconds)
 {
@@ -648,9 +658,9 @@ radv_ps5_memory_free(struct radv_ps5_memory *memory)
    *memory = (struct radv_ps5_memory){.physical = -1};
 }
 
-/* Where radv_ps5_submit's time went (radv_ps5_submit_times); [2] is the kick
- * thread's. */
-static uint64_t radv_ps5_submit_ns[3];
+/* Where radv_ps5_submit's time went, in ticks (radv_ps5_submit_times); [2] is
+ * the kick thread's. */
+static uint64_t radv_ps5_submit_ticks[3];
 
 /* Without a suspend point after it the console starts a submission up to a
  * refresh late (PS5_Vulkan R68), and the suspend point took about 0.3 ms a
@@ -672,9 +682,9 @@ radv_ps5_kick_body(void *unused)
          cnd_wait(&radv_ps5_kick_wanted, &radv_ps5_kick_lock);
       radv_ps5_kick_pending = false;
       mtx_unlock(&radv_ps5_kick_lock);
-      const uint64_t started = os_time_get_nano();
+      const uint64_t started = radv_ps5_ticks();
       const int32_t result = sceAgcSuspendPoint();
-      p_atomic_add(&radv_ps5_submit_ns[2], os_time_get_nano() - started);
+      p_atomic_add(&radv_ps5_submit_ticks[2], radv_ps5_ticks() - started);
       if (result != 0)
          fprintf(stderr, "radv/ps5: sceAgcSuspendPoint failed: 0x%08x\n", (unsigned)result);
       mtx_lock(&radv_ps5_kick_lock);
@@ -697,17 +707,17 @@ radv_ps5_submit(uint32_t *words, uint32_t count, volatile uint32_t *marker, uint
 {
    (void)marker;
    (void)marker_value;
-   const uint64_t started = os_time_get_nano();
+   const uint64_t started = radv_ps5_ticks();
    radv_ps5_cpu_flush(words, (size_t)count * sizeof(uint32_t));
-   const uint64_t flushed = os_time_get_nano();
+   const uint64_t flushed = radv_ps5_ticks();
    struct ps5_agc_submit_description description = {
       .words = words,
       .word_count = count,
    };
    int32_t result = sceAgcDriverSubmitDcb(&description);
-   const uint64_t submitted = os_time_get_nano();
-   radv_ps5_submit_ns[0] += flushed - started;
-   radv_ps5_submit_ns[1] += submitted - flushed;
+   const uint64_t submitted = radv_ps5_ticks();
+   radv_ps5_submit_ticks[0] += flushed - started;
+   radv_ps5_submit_ticks[1] += submitted - flushed;
    if (result != 0)
       return result;
    call_once(&radv_ps5_kick_once, radv_ps5_kick_start);
@@ -722,7 +732,7 @@ void
 radv_ps5_submit_times(uint64_t times[3])
 {
    for (unsigned i = 0; i < 3; i++)
-      times[i] = p_atomic_xchg(&radv_ps5_submit_ns[i], 0);
+      times[i] = p_atomic_xchg(&radv_ps5_submit_ticks[i], 0);
 }
 
 int
diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.h b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.h
index 68bdeb3..7fcfd38 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.h
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.h
@@ -103,10 +103,17 @@ void radv_ps5_cpu_flush(const void *address, size_t bytes);
  * marker once they have run; the host model writes it at once. */
 int radv_ps5_submit(uint32_t *words, uint32_t count, volatile uint32_t *marker, uint32_t marker_value);
 
-/* The nanoseconds radv_ps5_submit spent since the last call, in the cache
- * flush, in sceAgcDriverSubmitDcb and in sceAgcSuspendPoint (called with the
- * submit lock held, as radv_ps5_submit is). */
+/* The ticks (radv_ps5_ticks) radv_ps5_submit spent since the last call, in the
+ * cache flush, in sceAgcDriverSubmitDcb and in sceAgcSuspendPoint (called with
+ * the submit lock held, as radv_ps5_submit is). */
 void radv_ps5_submit_times(uint64_t times[3]);
+
+/* A timestamp for timing the submission path: the TSC on the console, read in
+ * about 12 ns where clock_gettime is a system call (PS5_Vulkan R34: 20 us; R68:
+ * about 800 ns), and the monotonic clock's nanoseconds on the host. Only its
+ * differences mean anything; their rate is calibrated against the monotonic
+ * clock where they are reported (radv_ps5_cs.c). */
+uint64_t radv_ps5_ticks(void);
 /* The tessellation factor ring the GPU uses from the next submission on (AGC
  * owns its registers); 0 or the system software's error. */
 int radv_ps5_set_tess_factor_ring(uint64_t va, uint32_t size);
