diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_cs.c b/src/amd/vulkan/winsys/ps5/radv_ps5_cs.c
index a04d832..7bcf172 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_cs.c
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_cs.c
@@ -830,6 +830,45 @@ radv_ps5_cs_submit(struct radeon_winsys_ctx *rctx, const struct radv_winsys_subm
    return VK_SUCCESS;
 }
 
+int
+radv_ps5_submit_after(const uint32_t *words, uint32_t count)
+{
+   struct radv_ps5_queue *const queue = radv_ps5_queue_get();
+   if (!queue || count == 0 || count > RADV_PS5_RING_WORDS / 4)
+      return -1;
+   const uint32_t total = count + RADV_PS5_COMPLETION_WORDS;
+
+   simple_mtx_lock(&queue->submit_lock);
+   const uint64_t seq = queue->submitted_seq + 1;
+   const uint64_t claim_start = radv_ps5_ticks();
+   uint32_t *const ring = radv_ps5_queue_claim(queue, total, seq);
+   const uint64_t copy_start = radv_ps5_ticks();
+   if (!ring) {
+      simple_mtx_unlock(&queue->submit_lock);
+      return -1;
+   }
+   /* No GPU time of its own: its slot says so to the retire. */
+   if (queue->gpu_time_state > 0) {
+      volatile uint64_t *const slot = radv_ps5_gpu_time_slot(queue, seq);
+      slot[0] = slot[1] = UINT64_MAX;
+   }
+   uint32_t *at = radv_ps5_stream_words(ring, words, count);
+   uint32_t completion[RADV_PS5_COMPLETION_WORDS];
+   radv_ps5_completion_words(completion, (uint64_t)(uintptr_t)queue->marker, (uint32_t)seq);
+   at = radv_ps5_stream_words(at, completion, RADV_PS5_COMPLETION_WORDS);
+   assert((uint32_t)(at - ring) == total);
+   const uint64_t copy_end = radv_ps5_ticks();
+
+   p_atomic_set(&queue->submitted_seq, seq);
+   const int submitted = radv_ps5_submit(ring, total, RADV_PS5_STREAMED_COPY, queue->marker, (uint32_t)seq);
+   radv_ps5_note_submission(queue, total, copy_start - claim_start, copy_end - copy_start);
+   simple_mtx_unlock(&queue->submit_lock);
+   if (submitted != 0)
+      fprintf(stderr, "radv/ps5: sceAgcDriverSubmitDcb failed for words submitted after the rest: 0x%08x\n",
+              (unsigned)submitted);
+   return submitted;
+}
+
