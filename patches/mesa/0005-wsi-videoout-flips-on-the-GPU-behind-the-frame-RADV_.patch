+/* The PS5 winsys's submission of words the GPU runs after everything submitted
+ * before them (radv_ps5_cs.c), which a flip on the GPU goes through. Weak: the
+ * swapchain links without it, and flips from the CPU then. */
+extern int radv_ps5_submit_after(const uint32_t *words, uint32_t count) __attribute__((weak));
+
 /* Buffers in each size's set. */
 #define VIDEOOUT_BUFFERS 5
 #define VIDEOOUT_BUFFER_ALIGNMENT (UINT64_C(2) << 20)
@@ -158,6 +169,33 @@ sceVideoOutConfigureOutput(int32_t handle, uint32_t mode, const void *a, const v
 {
    return -1;
 }
+
+struct ps5_agc_command_buffer {
+   uint32_t *bottom;
+   uint32_t *top;
+   uint32_t *up;
+   uint32_t *down;
+   uintptr_t callback;
+   void *user_data;
+   uint32_t reserved_dwords;
+   uint32_t padding;
+};
+
+/* The flip as the 64 words the console's helper takes, one NOP here, and shown
+ * at once, as the model's sceVideoOutSubmitFlip shows one. */
+static uint32_t *
+sceAgcDcbSetFlip(struct ps5_agc_command_buffer *buffer, uint32_t video, int buffer_index, uint32_t mode,
+                 int64_t marker)
+{
+   uint32_t *const start = buffer->up;
+   if (buffer->top - buffer->up < 64)
+      return NULL;
+   start[0] = 0xc03e1000u; /* PKT3(NOP, 62): the header and 63 words */
+   memset(start + 1, 0, 63 * sizeof(uint32_t));
+   buffer->up += 64;
+   host_shown_argument = marker;
+   return start;
+}
 #endif
 
 /* The sizes VideoOut takes buffers of, the largest first, and a buffer's
@@ -280,6 +318,13 @@ struct wsi_videoout_output {
    thrd_t thread;
    struct wsi_videoout_present queue[VIDEOOUT_BUFFERS * 2];
    uint32_t queue_head, queue_count;
+
+   /* Flips on the GPU (RADV_PS5_GPU_FLIP=1): 0 until the first present
+    * decides, 1 on, -1 off. Whether a present has gone to the thread all the
+    * same, and how many flips the GPU was given, for the log. */
+   int gpu_flip;
+   bool gpu_flip_fell_back;
+   uint64_t gpu_flips;
 };
 
 static struct wsi_videoout_output videoout_output = {
@@ -544,6 +589,95 @@ videoout_flip_thread(void *data)
    return 0;
 }
 
+/* --- Flips on the GPU ---------------------------------------------------- */
+
+/* sceAgcDcbSetFlip reserves 64 words and writes 19 of them, the last the
+ * header of a NOP whose body it leaves as the buffer held it (PS5_Vulkan,
+ * 2026-09-17): zeroes here. The rest is room the helper never needed. */
+#define VIDEOOUT_GPU_FLIP_WORDS 256
+
+/* AGC's call when a helper needs more words than a command buffer has left.
+ * The buffer is sized so that it never does; the helper then fails. */
+static uint8_t
+videoout_agc_out_of_space(struct ps5_agc_command_buffer *buffer, uint32_t words, void *user_data)
+{
+   (void)buffer;
+   (void)words;
+   (void)user_data;
+   return 0;
+}
+
+/* Whether flips go on the GPU (RADV_PS5_GPU_FLIP=1): decided at the first
+ * present, for the whole process, since flips from the GPU and from the
+ * thread could reach VideoOut out of order. Under lock. */
+static bool
+videoout_gpu_flip_locked(void)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   if (out->gpu_flip == 0) {
+      const bool asked = debug_get_bool_option("RADV_PS5_GPU_FLIP", false);
+      out->gpu_flip = asked && radv_ps5_submit_after != NULL ? 1 : -1;
+      if (asked)
+         fprintf(stderr, "wsi/videoout: %s\n",
+                 out->gpu_flip > 0 ? "flips on the GPU (RADV_PS5_GPU_FLIP)"
+                                   : "RADV_PS5_GPU_FLIP: this driver has no submission for flips; they go from the CPU");
+   }
+   return out->gpu_flip > 0;
+}
+
+/* Whether a present's fence has been submitted for signalling: the frame's
+ * work is then on the GPU's queue, which runs in order, so a flip submitted
+ * after it runs after the frame. It has unless the present's submission was
+ * deferred, waiting for a timeline value not yet submitted. */
+static bool
+videoout_frame_submitted(const struct wsi_videoout_swapchain *chain, VkFence handle)
+{
+   VK_FROM_HANDLE(vk_device, device, chain->base.device);
+   VK_FROM_HANDLE(vk_fence, fence, handle);
+   return vk_sync_wait(device, vk_fence_get_active_sync(fence), 0, VK_SYNC_WAIT_PENDING, 0) == VK_SUCCESS;
+}
+
+/* The flip of buffer, on the GPU's queue behind its frame: the GPU hands it to
+ * VideoOut as it reaches the flip, once the frame's work is done, where the
+ * flip thread spins a core on each frame's fence and then wakes up to a sleep
+ * after it. The packets are AGC's (sceAgcDcbSetFlip, mode 1, the way
+ * PS5_Vulkan's first driver presented: M5 C1, R74) in a submission of their
+ * own; VideoOut's flip status reports the argument they carry as a flip's
+ * from the CPU does. Under lock; false when the flip was not submitted. */
+static bool
+videoout_flip_on_gpu_locked(uint32_t buffer)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   uint32_t words[VIDEOOUT_GPU_FLIP_WORDS] = {0};
+   struct ps5_agc_command_buffer command = {
+      .bottom = words,
+      .top = words + VIDEOOUT_GPU_FLIP_WORDS - 1,
+      .up = words,
+      .down = words + VIDEOOUT_GPU_FLIP_WORDS - 1,
+      .callback = (uintptr_t)videoout_agc_out_of_space,
+   };
+   const int64_t argument = out->flip_argument + 1;
+   if (!sceAgcDcbSetFlip(&command, (uint32_t)out->handle, (int)buffer, PS5_VIDEO_OUT_FLIP_VSYNC, argument) ||
+       command.up <= command.bottom || command.up > command.top) {
+      fprintf(stderr, "wsi/videoout: sceAgcDcbSetFlip wrote no flip of buffer %u; flips go from the CPU\n", buffer);
+      out->gpu_flip = -1;
+      return false;
+   }
+   const int result = radv_ps5_submit_after(words, (uint32_t)(command.up - command.bottom));
+   if (result != 0) {
+      fprintf(stderr, "wsi/videoout: the flip of buffer %u was not submitted (%d); flips go from the CPU\n", buffer,
+              result);
+      out->gpu_flip = -1;
+      return false;
+   }
+   out->flip_argument = argument;
+   out->buffer[buffer].argument = argument;
+   if (out->gpu_flips++ == 0)
+      fprintf(stderr, "wsi/videoout: the first flip on the GPU: buffer %u, %u words\n", buffer,
+              (unsigned)(command.up - command.bottom));
+   return true;
+}
